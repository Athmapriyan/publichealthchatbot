# Copy this file to .env and fill in real values. NEVER commit .env.

# Order to try LLM providers in, comma-separated, first-to-last.
LLM_PROVIDER_ORDER=groq,gemini,openrouter

# --- Groq (recommended primary: free, no card, ~14,400 req/day) ---
# Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Google Gemini (free tier available) ---
# Get a key at https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- OpenRouter (free :free-suffixed models available) ---
# Get a key at https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Hugging Face (optional, for local/embedding fallback experiments) ---
HF_API_KEY=

# --- Sarvam AI (multilingual: translation + language identification) ---
# Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1

# --- Telegram bot ---
# Get a token from @BotFather on Telegram (send /newbot and follow the prompts)
TELEGRAM_BOT_TOKEN=
# Where the Telegram bot should send API requests. Keep as localhost while
# developing; point to your deployed backend's public URL in production.
BACKEND_BASE_URL=

# --- RAG ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_PATH=
RAG_TOP_K=
RAG_SCORE_THRESHOLD=

KNOWLEDGE_BASE_PATH=.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/app.db
